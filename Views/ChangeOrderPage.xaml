<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AllAroundEstimates.Models"
             x:Class="AllAroundEstimates.Views.ChangeOrderPage"
             Title="Change Order">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Pull Up a Previous Estimate (optional)" />
            <Entry x:Name="CustomerSearchEntry"
                   Placeholder="Search by customer name..."
                   TextChanged="OnCustomerSearchTextChanged" />

            <Border Stroke="LightGray" StrokeThickness="1" Padding="0" Margin="0,4,0,0">
                <CollectionView x:Name="PreviousEstimatesList"
                                HeightRequest="160"
                                SelectionMode="Single"
                                SelectionChanged="OnPreviousEstimateSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedEstimate">
                            <Grid Padding="10,8">
                                <Label Text="{Binding DisplayText}" LineBreakMode="TailTruncation" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No matching estimates."
                               TextColor="Gray"
                               FontSize="12"
                               Padding="10,8" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>

            <Label Text="Customer Name" Margin="0,10,0,0" />
            <Entry x:Name="CustomerNameEntry" Placeholder="Customer name" />

            <Label Text="Original Estimate Number" Margin="0,10,0,0" />
            <Entry x:Name="OriginalEstimateNumberEntry" Placeholder="EST-000000000000" />

            <Label Text="Original Total Amount ($)" Margin="0,10,0,0" />
            <Entry x:Name="OriginalTotalEntry" Keyboard="Numeric" Placeholder="0.00" />

            <Label Text="Description of Changes" Margin="0,10,0,0" />
            <Editor x:Name="DescriptionEditor" HeightRequest="120" Placeholder="Describe the changes..." />

            <Label Text="Cost of Extra Materials/Labor ($)" Margin="0,10,0,0" />
            <Entry x:Name="CostOfChangeEntry" Keyboard="Numeric" Placeholder="0.00" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,16" />

            <Label Text="Summary" FontAttributes="Bold" />
            <Editor x:Name="SummaryEditor"
                    IsReadOnly="True"
                    HeightRequest="110"
                    BackgroundColor="#F5F5F5"
                    TextColor="Black"
                    FontFamily="Courier New" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,16,0,0">
                <Button Text="Calculate" Clicked="OnCalculateClicked" />
                <Button Text="Save Change Order" Clicked="OnSaveClicked" />
                <Button Text="Export PDF" Clicked="OnExportClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
