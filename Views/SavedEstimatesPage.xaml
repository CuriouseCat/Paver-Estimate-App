<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AllAroundEstimates.Models"
             x:Class="AllAroundEstimates.Views.SavedEstimatesPage"
             Title="Saved Estimates">

    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">

        <Label Grid.Row="0" Text="Search by Customer Name" />
        <Entry Grid.Row="1" x:Name="SearchEntry" Placeholder="Customer name..." TextChanged="OnSearchTextChanged" />
        <Label Grid.Row="2" Text="Tap an estimate to edit it or create a deposit/final invoice." FontSize="12" TextColor="Gray" />

        <CollectionView Grid.Row="3" x:Name="EstimatesList" SelectionMode="Single" SelectionChanged="OnEstimateSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SavedEstimate">
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="10,8" Margin="0,4">
                        <Label Text="{Binding DisplayText}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No saved estimates yet." TextColor="Gray" FontSize="12" Padding="10,8" />
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</ContentPage>
