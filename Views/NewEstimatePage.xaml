<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AllAroundEstimates.Views.NewEstimatePage"
             Title="New Estimate">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Customer Name" />
            <Entry x:Name="CustomerNameEntry" Placeholder="Customer name" />

            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Customer Contact Information" FontAttributes="Bold" />

                    <Label Text="Phone" />
                    <Entry x:Name="CustomerPhoneEntry" Keyboard="Telephone" Placeholder="(555) 555-5555" />

                    <Label Text="Email" />
                    <Entry x:Name="CustomerEmailEntry" Keyboard="Email" Placeholder="customer@example.com" />

                    <Label Text="Address" />
                    <Entry x:Name="CustomerAddressEntry" Placeholder="Street, City, State ZIP" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Service Lines" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Manage Types"
                                Clicked="OnManageTypesClicked"
                                FontSize="12"
                                Padding="10,6" />
                    </Grid>
                    <Label Text="Add a line for each type of work on this job -- e.g. an install portion and a repair portion, each at its own rate."
                           FontSize="12"
                           TextColor="Gray" />

                    <VerticalStackLayout x:Name="ServiceLinesContainer" Spacing="10" Margin="0,6,0,0" />

                    <Button Text="+ Add Service Line"
                            Clicked="OnAddServiceLineClicked"
                            HorizontalOptions="Start"
                            FontSize="12"
                            Padding="10,6" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Base Material Cost ($)" Margin="0,10,0,0" />
            <Entry x:Name="BaseMaterialCostEntry" Keyboard="Numeric" Placeholder="0.00" />

            <Label Text="Labor Hours (per employee)" Margin="0,10,0,0" />
            <Entry x:Name="LaborHoursEntry" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Number of Employees" Margin="0,10,0,0" />
            <Entry x:Name="NumberOfEmployeesEntry" Keyboard="Numeric" Placeholder="1" />

            <Label Text="Hourly Labor Rate ($)" Margin="0,10,0,0" />
            <Entry x:Name="HourlyRateEntry" Keyboard="Numeric" Placeholder="0.00" />

            <Label Text="Extra Costs ($)" Margin="0,10,0,0" />
            <Entry x:Name="ExtraCostsEntry" Keyboard="Numeric" Placeholder="0.00" />

            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Custom Charges" FontAttributes="Bold" />

                    <VerticalStackLayout x:Name="CustomChargesContainer" Spacing="8" />

                    <Button Text="+ Add Custom Charge"
                            Clicked="OnAddCustomChargeClicked"
                            HorizontalOptions="Start"
                            FontSize="12"
                            Padding="10,6" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,16" />

            <Label Text="Summary" FontAttributes="Bold" />
            <Editor x:Name="SummaryEditor"
                    IsReadOnly="True"
                    HeightRequest="150"
                    BackgroundColor="#F5F5F5"
                    TextColor="Black"
                    FontFamily="Courier New" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,16,0,0">
                <Button Text="Calculate" Clicked="OnCalculateClicked" />
                <Button Text="Save Estimate" Clicked="OnSaveClicked" />
                <Button Text="Export PDF" Clicked="OnExportClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
