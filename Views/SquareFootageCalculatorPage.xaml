<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AllAroundEstimates.Views.SquareFootageCalculatorPage"
             Title="Square Footage Calculator">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Square Footage Calculator" FontSize="20" FontAttributes="Bold" />
            <Label Text="Add a section for each rectangular area (length x width) that makes up this job. Sections are totaled together below."
                   FontSize="12"
                   TextColor="Gray" />

            <VerticalStackLayout x:Name="SectionsContainer" Spacing="10" Margin="0,16,0,0" />

            <Button Text="+ Add Section"
                    Clicked="OnAddSectionClicked"
                    HorizontalOptions="Start"
                    FontSize="12"
                    Padding="10,6"
                    Margin="0,10,0,0" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,16" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Total Square Footage:" FontAttributes="Bold" VerticalOptions="Center" />
                <Label Grid.Column="1" x:Name="TotalLabel" Text="0" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
            </Grid>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
                <Button Text="Cancel" Clicked="OnCancelClicked" />
                <Button Text="Use This Total" Clicked="OnUseTotalClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
